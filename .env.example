# Copy to .env and replace the placeholders before starting the stack.
POSTGRES_DB=bowdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-private-local-password

# Optional: create a first admin account on an empty database.
# Set both values or leave both empty. Password must be 12+ characters.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

FRONTEND_ORIGIN=http://localhost:5173
SESSION_COOKIE_SECURE=false
